# ── App URLs ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Clerk ─────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
# Issuer used to validate API JWTs (Clerk Frontend API URL)
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ── LiveKit (local dev server) ────────────────────────────
# Start with: livekit-server --dev
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# ── OpenAI (fallback when VOICE_PROVIDER=openai) ──────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# ── Groq (default free voice pipeline) ───────────────────
VOICE_PROVIDER=groq
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural
GROQ_API_KEY=gsk_xxx
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=en
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
AGENT_NAME=voice-agent
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Phase 2 data plane ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5432/voice
REDIS_URL=redis://localhost:6379/0
AGENT_SERVICE_TOKEN=dev-agent-token-change-me
API_BASE_URL=http://localhost:8000

# ── Phase 3 / 4 ───────────────────────────────────────────
TEMPORAL_HOST=
MCP_NOTION_URL=
DESKTOP_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── Observability ─────────────────────────────────────────
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── API ───────────────────────────────────────────────────
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_HOST=0.0.0.0
API_PORT=8000
